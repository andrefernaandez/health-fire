  <step>
    <name>Selecionar internações por CID</name>
    <type>TableInput</type>
    <description />
    <distribute>Y</distribute>
    <custom_distribution />
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name />
    </partitioning>
    <connection>postgres_healthfire</connection>
    <sql>SELECT
    dt.id AS id_dim_tempo,
    dl.id AS id_dim_localidade,
    dci.id AS id_dim_cid,
    dc.type_health_id::int AS id_tipo_conteudo,
    EXTRACT(YEAR FROM dc.register_at)::int AS ano,
    EXTRACT(MONTH FROM dc.register_at)::int AS mes,
    dl.estado AS estado,
    dci.name AS nome_cid,
    SUM(dc.value)::int AS internacoes
FROM disease_cases_diseasecase dc
JOIN health_cid cid
    ON dc.cid_id = cid.id
JOIN dim_cid dci
    ON dci.id = cid.id
JOIN dim_tempo dt
    ON dt.ano = EXTRACT(YEAR FROM dc.register_at)::int
   AND dt.mes = EXTRACT(MONTH FROM dc.register_at)::int
JOIN dim_localidade dl
    ON LOWER(TRIM(dl.estado)) = LOWER(TRIM(
        CASE LOWER(TRIM(dc.federative_unit_name))
            WHEN 'mato grosso do sul' THEN 'Mato Grosso do Sul'
            WHEN 'rio de janeiro' THEN 'Rio de Janeiro'
            WHEN 'rio grande do norte' THEN 'Rio Grande do Norte'
            WHEN 'rio grande do sul' THEN 'Rio Grande do Sul'
            ELSE dc.federative_unit_name
        END
    ))
WHERE dc.type_health_id = 43
  AND dc.register_at &gt;= TIMESTAMP '2015-01-01'
  AND dc.register_at &lt; TIMESTAMP '2026-01-01'
  AND dc.federative_unit_name IS NOT NULL
  AND LOWER(TRIM(dc.federative_unit_name)) &lt;&gt; 'total'
  AND dc.cid_id IN (38, 63, 64, 65, 67, 68)
GROUP BY
    dt.id,
    dl.id,
    dci.id,
    dc.type_health_id,
    EXTRACT(YEAR FROM dc.register_at)::int,
    EXTRACT(MONTH FROM dc.register_at)::int,
    dl.estado,
    dci.name
ORDER BY ano, mes, estado, nome_cid;
</sql>
