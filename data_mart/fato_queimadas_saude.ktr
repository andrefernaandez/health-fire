  <step>
    <name>Dados de Casos de Doenças</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>postgres_healthfire</connection>
    <sql>SELECT
    dt.id AS id_dim_tempo,
    dl.id AS id_dim_localidade,
    th.name AS tipo_dado,
    dc.value AS total
FROM disease_cases_diseasecase dc
JOIN health_typecontent th ON dc.type_health_id = th.id
JOIN dim_tempo dt ON EXTRACT(YEAR FROM dc.register_at) = dt.ano
                  AND EXTRACT(MONTH FROM dc.register_at) = dt.mes
JOIN dim_localidade dl ON LOWER(dc.federative_unit_name) = LOWER(dl.estado)
WHERE th.name IN (
    'Internações por Unidade da Federação e Ano/mês atendimento',
    'Óbitos por Unidade da Federação e Ano/mês atendimento',
    'Taxa Mortalidade por Unidade da Federação e Ano/mês atendimento'
)
ORDER BY dt.id, dl.id, th.name;
</sql>
