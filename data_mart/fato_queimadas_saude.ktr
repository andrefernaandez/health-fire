  <step>
    <name> Dados de Queimadas Agregados
</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>postgres_healthfire</connection>
    <sql>SELECT
    dt.id AS id_dim_tempo,
    db.id AS id_dim_bioma,
    dl.id AS id_dim_localidade,
    COUNT(b.id) AS total_queimadas,

    FLOOR(GREATEST(0, AVG(NULLIF(b.no_rain_days, -999))))::int AS dias_sem_chuva,

    ROUND(AVG(NULLIF(b.precipitation, -999))::numeric, 2) AS precipitacao,

    ROUND(COALESCE(AVG(NULLIF(CASE WHEN b.fire_risk > 0 THEN b.fire_risk ELSE NULL END, -999)), 0)::numeric, 2) AS risco_fogo

FROM
    burned_burned b
JOIN
    geo_data_federativeunit fu ON b.federative_unit_id = fu.id
JOIN
    geo_data_biome bio ON b.biome_id = bio.id
JOIN
    dim_tempo dt ON EXTRACT(YEAR FROM b.register_at) = dt.ano
                AND EXTRACT(MONTH FROM b.register_at) = dt.mes
JOIN
    dim_bioma db ON bio.name = db.nome_bioma
JOIN
    dim_localidade dl ON LOWER(fu.name) = LOWER(dl.estado)
GROUP BY
    dt.id, db.id, dl.id
ORDER BY
    dt.id, db.id, dl.id;
</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
